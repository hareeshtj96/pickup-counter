# Copy to .env to override the local defaults used by docker-compose.yml.
#   cp .env.example .env
# These are LOCAL DEVELOPMENT values only. Never commit a real .env.
# Keep the password URL-safe (letters, digits, - and _) because it is embedded
# in DATABASE_URL.

# --- PostgreSQL ---
POSTGRES_USER=pickup
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=pickup_counter

# --- Host ports (change if something else already uses them) ---
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=4000
FRONTEND_HOST_PORT=5173

# --- Backend outside Docker (npm run dev / npm test on your machine) ---
# Inside Docker these are set by docker-compose.yml with host "db".
# DATABASE_URL=postgres://pickup:change_me_local_only@localhost:5433/pickup_counter
# TEST_DATABASE_URL=postgres://pickup:change_me_local_only@localhost:5433/pickup_counter_test
# PORT=4000
# DB_POOL_MAX=10
# SHUTDOWN_TIMEOUT_MS=10000

# --- Frontend outside Docker ---
# API_PROXY_TARGET=http://localhost:4000
# VITE_API_BASE_URL=/api
