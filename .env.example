# Copy to .env to override the local defaults used by docker-compose.yml.
#   cp .env.example .env
# These are LOCAL DEVELOPMENT values only and match the docker-compose.yml
# defaults exactly. Never commit a real .env.
# Keep the password URL-safe (letters, digits, - and _) because it is embedded
# in DATABASE_URL.
#
# NOTE: PostgreSQL applies POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB only
# when the data volume is first created. Changing them later does not change an
# existing database; see README "Changing the database password".

# --- PostgreSQL ---
POSTGRES_USER=pickup
POSTGRES_PASSWORD=pickup_dev_password
POSTGRES_DB=pickup_counter

# --- Payment webhook ---
# HMAC-SHA256 key used to verify X-Pickup-Signature on POST /payments/webhook.
# DEVELOPMENT-ONLY PLACEHOLDER: the API refuses any "dev-only-" value when
# NODE_ENV=production. Use a long random value from your provider elsewhere,
# e.g.  openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=dev-only-insecure-webhook-secret-change-me

# --- Host ports (change if something else already uses them) ---
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=4000
FRONTEND_HOST_PORT=5173

# --- Backend outside Docker (npm run dev / npm test on your machine) ---
# Inside Docker these are set by docker-compose.yml with host "db".
# TEST_DATABASE_URL must name pickup_counter_test on localhost:<POSTGRES_HOST_PORT>.
# DATABASE_URL=postgres://pickup:pickup_dev_password@localhost:5433/pickup_counter
# TEST_DATABASE_URL=postgres://pickup:pickup_dev_password@localhost:5433/pickup_counter_test
# PORT=4000
# DB_POOL_MAX=10
# SHUTDOWN_TIMEOUT_MS=10000
# ORDER_EXPIRY_SWEEP_INTERVAL_MS=15000

# --- Frontend outside Docker ---
# API_PROXY_TARGET=http://localhost:4000
# VITE_API_BASE_URL=/api
